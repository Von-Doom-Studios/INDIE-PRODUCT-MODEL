# Highstreet — Shopify Storefront credentials
# Copy this file to `.env.local` and fill in your values.
# Restart `npm run dev` after editing.

# Your store domain WITHOUT the protocol or trailing slash.
# Example: highstreet-shop.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token.
# Generate in Shopify admin → Settings → Apps and sales channels →
# Develop apps → (create app) → Configuration → Storefront API access tokens.
# Scopes needed: unauthenticated_read_product_listings,
# unauthenticated_write_checkouts, unauthenticated_read_checkouts.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
